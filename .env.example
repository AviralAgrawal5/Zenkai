# =============================================================================
# Zenkai — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# Per-service overrides (optional — falls back to DATABASE_URL)
FINANCE_DATABASE_URL=
REGISTRATION_DATABASE_URL=
LEARNING_DATABASE_URL=
ZENKAI_DATABASE_URL=

# ── AI ───────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Service URLs (used by services that call each other) ─────────────────────
FINANCE_SERVICE_URL=http://finance:8001
REGISTRATION_SERVICE_URL=http://registration:8002
LEARNING_SERVICE_URL=http://learning:8003
ZENKAI_CORE_URL=http://zenkai-core:8004

# ── Observability ────────────────────────────────────────────────────────────
LOKI_URL=http://loki:3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=zenkai

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
